# Request a Quote email (api/quote.ts). On Vercel, set these under
# Project → Settings → Environment Variables. For local testing, copy this file to
# .env.local (git ignores it) and fill in the values; `npm run dev` passes them on.

# Required in production: API key from https://resend.com (API Keys).
RESEND_API_KEY=

# Sender, on a domain you have verified in Resend (Domains).
# Before the domain is verified you can test with: onboarding@resend.dev
# (Resend then only delivers to the email address of your Resend account).
QUOTE_FROM=Fortune Tradelinks Website <website@fortunetradelinks.in>

# Optional: who receives quotes, comma-separated. Default: sales@fortunetradelinks.in
QUOTE_TO=
